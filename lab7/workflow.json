        "jsCode": "// Нормализуем входящее событие из любого триггера\nconst input = $input.first().json;\n\n// Если пришёл webhook от Alertmanager — берём данные алерта\n// Если ручной запуск — берём то, что передали вручную\nconst alert = input.alert || input.body?.alerts?.[0] || {};\n\nconst service = alert.labels?.service\n  || input.service\n  || 'catalog';\n\nconst symptom = alert.annotations?.summary\n  || input.symptom\n  || 'Рост памяти сервиса';\n\nreturn {\n  json: {\n    service: service,\n    symptom: symptom,\n    severity: alert.labels?.severity || input.severity || 'warning',\n    source: input.source || 'manual',\n  }\n};"
