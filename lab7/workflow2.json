        -368,
        64
      ],
      "id": "984ba9a7-7059-4315-a602-d397de848951",
      "name": "Webhook (Alert)",
      "webhookId": "incident-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Нормализуем входящее событие из любого триггера\nconst input = $input.first().json;\n\nconst alert = input.alert || input.body?.alerts?.[0] || {};\n\nconst service = alert.labels?.service\n  || input.service\n  || 'catalog';\n\nconst symptom = alert.annotations?.summary\n  || input.symptom\n  || 'Рост памяти сервиса';\n\nreturn {\n  json: {\n    service: service,\n    symptom: symptom,\n    severity: alert.labels?.severity || input.severity || 'warning',\n    source: input.source || 'manual',\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        -48
      ],
      "id": "c4350e4a-1fcb-4161-8870-0d1ebf15a4fb",
      "name": "Normalize Event"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — ассистент. Вызови инструмент read_file с path=\"/data/incidents/2026-09-14-catalog-memory-leak.md\" и верни его содержимое.",
        "options": {
          "forceToolCallOnFirstIteration": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        96,
        -224
      ],
      "id": "bb973305-e55d-41d1-8011-4b1d0277761a",
      "name": "Agent 1 Read KB"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — ассистент. Вызови инструмент prom_query с query=\"up\" и верни результат.",
        "options": {
          "forceToolCallOnFirstIteration": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        96,
        -48
      ],
      "id": "fc11f1a6-5bda-41bf-bd8b-70f8fa34b93e",
      "name": "Agent 2 Get Metrics"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — ассистент. Вызови инструмент list_commits с project_id=\"penoplasttt/catalog\" и верни результат.",
        "options": {
          "forceToolCallOnFirstIteration": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        96,
        144
      ],
      "id": "1fb7a88d-d831-4e20-b1ff-98800a56079f",
      "name": "Agent 3 Get Commits"
    },
    {
      "parameters": {
        "jsCode": "// Собираем результаты трёх агентов (по индексам входов) + данные инцидента\nconst items = $input.all();\nconst kb = items[0]?.json?.output || '';\nconst metrics = items[1]?.json?.output || '';\nconst commits = items[2]?.json?.output || '';\nconst incident = $('Normalize Event').first().json;\n\nreturn [{ json: { ...incident, kb, metrics, commits } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -48
      ],
      "id": "eb3420c0-59af-46b4-8b6a-0cacdd213545",
      "name": "Combine"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Ты — ИИ-ассистент диагностики инцидентов. На основе данных ниже сформулируй диагноз инцидента.\n\nВходные данные инцидента:\n- service: {{ $json.service }}\n- symptom: {{ $json.symptom }}\n- severity: {{ $json.severity }}\n\nСобранные данные:\n- База знаний: {{ $json.kb }}\n- Метрики: {{ $json.metrics }}\n- Коммиты: {{ $json.commits }}\n\nВерни диагноз: что сломалось, вероятная причина, что проверить/сделать.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        624,
        -48
      ],
